<div class='sc-container sc-container-skinny sc-container-spacious' data-general-error-message="{{ "checkout.payment.error" | t }}" data-timeout-error-message="{{ "checkout.payment.timeout_error" | t }}">
  <a href="{{ current_order.path }}" class="SC-Link sc-mb-large">
    {{ "accounts.orders.navigation.back_to_show" | t }}
  </a>

  <div class="SC-Panel_header">
    <div class="SC-Panel_header_heading">
      {{ "checkout.payment.header" | t }}
    </div>
  </div>

   <div class="SC-Grid">
     <div class="SC-Grid_main">
        {%- if current_order.total_payable <= 0 %}
          {{ "additional_payments.not_required" | t }}
        {%- elsif billing_address_required %}
          <h3 class="sc-mb-micro">{{ "additional_payments.billing_address.heading" | t }}</h3>
          <p class="sc-mb-base">{{ "additional_payments.billing_address.description" | t }}</p>
          {%- form "additional-payment-billing-address" %}
            {% render "checkout/customer_information/address", form: form, address_type: "billing" %}
            <button type="submit" class="SC-Button SC-Button-primary sc-mt-base">
              {{ "additional_payments.billing_address.submit" | t }}
            </button>
          {%- endform %}
        {%- else %}
          {%- if enable_custom_amount %}
            <div class="SC-Field sc-mb-base" id="custom-amount-container">
              <label for="custom-payment-amount" class="SC-Field_label">
                {{ "additional_payments.custom_amount.label" | t }}
              </label>
              <input
                type="number"
                id="custom-payment-amount"
                class="SC-Field_input"
                style="width: 200px;"
                step="0.01"
                min="0.01"
                max="{{ current_order.total_payable }}"
                placeholder="{{ current_order.amount_due_now | money }}"
                data-order-ref="{{ current_order.reference }}"
                {%- if custom_amount %} value="{{ custom_amount }}"{%- endif %}
              />
            </div>
          {%- endif %}
          {% render "checkout/payment_information/select_and_payment" %}
        {%- endif %}
     </div>
     <div class="SC-Grid_summary sc-mb-base">
      {% render "orders/order_summary", source: current_order %}
     </div>
   </div>

</div>
