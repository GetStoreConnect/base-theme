{% liquid
  default source: nil

  if source == nil
    case context.source_object
      when "Cart"
        query "s_c__cart__c" as results, token: context.source_id
      when "Order"
        query "order" as results, s_c__sc_id__c: context.source_id
      else
        assign results = false
        assign error = "Component 'orders/order_summary' requires 'source_object' of either 'cart' or 'order'. Got: '" | append: context.source_object | append: "'"
        debug query: error
    endcase

    if results and results.size > 0
      assign source = results.first | cast: context.source_object
    endif
  else
    capture source_object
      echo source
    endcapture
    context source_object: source_object, source_id: source.id
  endif
-%}

{%- unless source == nil %}
  <aside id="SC-OrderSummary" class="SC-Panel sc-mb-spacious" data-checkout-summary>
    <header class="SC-Panel_header">
      <h3 class="SC-Panel_header_heading">
        {{ "accounts.orders.show.order_summary.header" | t }}
        {% if source.test_order? %} - TESTING ONLY{% endif %}
      </h3>
    </header>
    <div>
      {%- if source != empty and source.items.size > 0 %}
        {%- render "shared/cart/items", source: source, width: "60px" %}
      {%- endif %}
    </div>
    {%- render "shared/order_total", source: source %}
  </aside>
{%- endunless %}
