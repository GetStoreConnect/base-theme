{% assign valid_providers = current_store.payment_providers | where: "valid_payment_method?" %}
{% assign first_provider = valid_providers | first %}
{% assign multiple_providers = valid_providers.size > 1 %}

<section class="SC-ExpressCheckoutForProduct sc-mt">
  {%- for payment_provider in valid_providers %}
    {% if payment_provider.supports_express_checkout? %}
      <div>
        {% case payment_provider.code %}
        {% when "Adyen" %}
          {% render "checkout/payment_information/payment_providers/adyen_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id,
                wallet_disabled: wallet_disabled
          %}
        {% when "Afterpay" %}
          {% render "checkout/payment_information/payment_providers/afterpay_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id
          %}
        {% when "CyberSource" %}
          {% render "checkout/payment_information/payment_providers/cyber_source_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id,
                wallet_disabled: wallet_disabled
          %}
        {% when "Eway" %}
          {% render "checkout/payment_information/payment_providers/eway_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id
          %}
        {% when "Stripe" %}
          {% render "checkout/payment_information/payment_providers/stripe_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id,
                wallet_disabled: wallet_disabled
          %}
        {% when "WestpacOnlinePay" %}
          {% render "checkout/payment_information/payment_providers/westpac_online_pay_form",
                payment_provider: payment_provider,
                only_express_checkout: true,
                dedicated_cart_product_id: product.id,
                wallet_disabled: wallet_disabled
          %}
        {% else %}
          <p>Missing payment method - set it up now in <code>app/liquid/theme/snippets/products/product/express_checkout.liquid</code></p>
          <p>payment_provider.code = <code>{{ payment_provider.code }}</code></p>
        {% endcase %}
      </div>
    {% endif %}
  {%- endfor %}
</section>
