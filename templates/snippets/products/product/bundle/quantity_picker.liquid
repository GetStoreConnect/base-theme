{%- assign min_qty = component.min_quantity %}
{%- assign max_qty = component.max_quantity %}
{%- assign current_qty = current_quantity | default: component.default_quantity %}
{%- assign component_id = component.id %}

<div class="bundle-quantity-picker" data-quantity-picker="{{ component_id }}">
  <label class="quantity-label sc-font-small sc-shade-dark">
    {{ "bundles.product.quantity" | t }}
    {%- if min_qty > 0 and max_qty %}
      <span class="quantity-range sc-shade-light">({{ min_qty }}-{{ max_qty }})</span>
    {%- elsif min_qty > 0 %}
      <span class="quantity-range sc-shade-light">(min {{ min_qty }})</span>
    {%- elsif max_qty %}
      <span class="quantity-range sc-shade-light">(max {{ max_qty }})</span>
    {%- endif %}
  </label>

  <div class="SC-QuantityPicker SC-QuantityPicker-large">
    <button type="button"
            class="SC-QuantityPicker_button SC-QuantityPicker_button-decrease"
            data-quantity-decrease="{{ component_id }}"
            {{ if current_qty <= min_qty }}disabled{{ endif }}>
      -
    </button>

    <input type="number" 
           class="SC-QuantityPicker_input"
           data-quantity-input="{{ component_id }}"
           value="{{ current_qty }}"
           min="{{ min_qty }}"
           {{ if max_qty }}max="{{ max_qty }}"{{ endif }}
           step="1">

    <button type="button" 
            class="SC-QuantityPicker_button SC-QuantityPicker_button-increase"
            data-quantity-increase="{{ component_id }}"
            {{ if max_qty and current_qty >= max_qty }}disabled{{ endif }}>
      +
    </button>
  </div>

  {%- if component.has_free_quantity? %}
    <div class="free-quantity-indicator sc-font-small sc-color-success sc-mt-small">
      {%- assign chargeable_qty = current_qty | minus: component.free_quantity %}
      {%- if chargeable_qty <= 0 %}
        {{ "bundles.product.all_included_free" | t: quantity: current_qty }}
      {%- else %}
        {{ "bundles.product.free_and_chargeable" | t: free_quantity: component.free_quantity, chargeable_quantity: chargeable_qty }}
      {%- endif %}
    </div>
  {%- endif %}

  <div class="quantity-errors" data-quantity-errors="{{ component_id }}">
    {%- comment -%} Error messages populated by JavaScript {%- endcomment -%}
  </div>
</div>
