{%- default source: nil -%}
{%- default local: false -%}
{%- assign voucher_source = source | default: current_cart %}
{%- assign remote_forms = true %}
{%- if local %}{%- assign remote_forms = false %}{%- endif %}
{%- comment %}
  source: the cart or order the vouchers are applied to; defaults to current_cart.
  local: true submits the remove forms as full page posts instead of remote.
  show: "balance" (default) renders the voucher's remaining balance on the
  row (SC behaviour); "amount" renders the amount applied to the source
  (gift cards, where a custom amount may use only part of the card).
{% endcomment %}
{% default show: "balance" %}
{%- assign provider_vouchers = voucher_source.all_vouchers | where: "provider", provider_name %}
{%- for voucher in provider_vouchers %}
  <div class="SC-Voucher-itemWrapper" data-all-vouchers>
    <div class="SC-Voucher-row{% if voucher.state == 'requires_pin' %} SC-Voucher-row--requires-pin{% endif %}">
      <div>{{ voucher.identifier }}</div>

      <div class="SC-Voucher-status">
        {{ "checkout.vouchers.status.enum." | append: voucher.state | t }}
      </div>

      <div>
        {%- if show == "amount" %}{{ voucher.amount | money }}{% else %}{{ voucher.balance | money }}{% endif %}
      </div>
    </div>
    {% form "remove-voucher", voucher: voucher, data-success: "sc.voucher-removed", data-type: "json", remote: remote_forms, data-reset-flash: true %}
      <button class="SC-Voucher-removeButton" id="remove-voucher-btn">{% render "/shared/icons/close" %}</button>
    {% endform %}
  </div>
{%- endfor %}
