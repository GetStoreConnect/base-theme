{%- default only_express_checkout: false %}
{%- default dedicated_cart_product_id: nil %}
{%- default wallet_disabled: false %}

<div data-provider-container="{{ payment_provider.code }}">
  <div data-ref="script-block"></div>

  <div data-ref="wallets-container" style="margin-bottom: 20px" data-click-blocker="{% if wallet_disabled %}not-allowed{% endif %}">
    <div data-ref="wallet-buttons" class="SC-Field"></div>
    <div data-ref="wallet-error" class="SC-Field SC-Alert sc-mt-small sc-hide"></div>
  </div>

  {%- form "payment", provider: payment_provider, class: "SC-Panel",
              only-express-checkout: only_express_checkout,
              dedicated-cart-product-id: dedicated_cart_product_id
             %}

    {% unless only_express_checkout %}
      {{ payment_provider.description_content }}

      {% render "checkout/payment_information/payment_providers/stripe/form",
              form: form, payment_provider: payment_provider  %}

      {% render "checkout/payment_information/additional_info", form: form %}

      {% render "checkout/payment_information/submit_button" %}
    {% endunless %}

    {% render "checkout/payment_information/payment_error" %}
  {%- endform %}
</div>

{%- require 'scripts/gateways/stripe.js' %}
