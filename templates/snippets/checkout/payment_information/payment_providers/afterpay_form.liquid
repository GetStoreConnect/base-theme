        </button>
      </div>
      <div data-ref="wallet-error" class="SC-Field SC-Alert sc-mt-small sc-hide"></div>
    </div>
  {%- endif %}
{%- endunless %}

{%- form "payment", provider: payment_provider, class: "SC-Panel",
            id: form_id,
            only-express-checkout: only_express_checkout,
            dedicated-cart-product-id: dedicated_cart_product_id
           %}

  {% unless only_express_checkout %}
    {% if payment_provider.description_content == blank %}
      {{ 'checkout.gateways.afterpay.description_html' | t }}
    {% else %}
      {{ payment_provider.description_content }}
    {% endif %}

    <div id="{{ payment_error_id }}" class="SC-Field SC-Alert sc-hide"></div>

    {% render "checkout/payment_information/additional_info", form: form %}

    <button id="{{ button_id }}" data-ref="pay-now" type="button" style="min-width: 18rem;">
