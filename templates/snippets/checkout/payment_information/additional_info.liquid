{% if current_subscription == blank %}
  {% render "checkout/customer_notes", form: form %}

  {% if current_order != blank and current_order.assisted_by_name != blank %}
    <div class="sc-mt sc-mb SC-Field">
      <label class="SC-Field_label">{{ "checkout.assisted_by.were_you_assisted_with_this_order" | t }}</label>
      <p class="sc-mt-small">{{ current_order.assisted_by_name }}</p>
    </div>
  {% elsif current_store.staff.size > 0 %}
    {% render "checkout/assisted_by_user", form: form %}
  {% endif %}

  {%# Questions %}
  {%- if current_cart != blank and current_cart.custom_forms.size > 0 %}
    {% render "custom_forms/forms", custom_forms: current_cart.custom_forms, form: form, display_mode: "in_checkout" %}
  {%- endif %}
{%- endif %}
