<div data-flash-container>
  <div class="sc-container sc-mt {% unless current_flash and current_flash.notice != blank %}sc-hide{% endunless %}">
    <div class="SC-Notice" data-notice>
      {{ current_flash | try: "notice" }}
    </div>
  </div>

  <div class="sc-container sc-mt {% unless current_flash and current_flash.alert != blank %}sc-hide{% endunless %}">
    <div class="SC-Notice SC-Notice-alert" data-alert>
      {{ current_flash | try: "alert" }}
    </div>
  </div>
</div>

{%- require "scripts/flash.js" %}
