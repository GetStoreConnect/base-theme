<div class="sc-flex-row sc-align-items-center">
  <span class="sc-grow">
    <h3>{{ "accounts.profile.sections.carts.heading" | t }}</h3>
  </span>
  <span>
    <a href="{{ current_store.carts_path }}" class="SC-Button">{{ "accounts.profile.sections.carts.view_all" | t }}</a>
  </span>
</div>
{%- if current_customer.carts.size > 0 %}
  <p>{{ "accounts.profile.sections.carts.count" | t, count: current_customer.carts.size }}</p>

  {% assign cart = current_customer.carts.first %}
  <h4>{{ "accounts.profile.sections.carts.most_recent" | t }}</h4>

  <table>
    <tr>
      <th>{{ "accounts.carts.index.date" | t }}</th>
      <th>{{ "accounts.carts.index.items" | t }}</th>
    </tr>
    <tr>
      {% capture is_current %}
        {% if cart.id == current_cart.id %}
          {{ "accounts.carts.index.current" | t }}
        {% endif %}
      {% endcapture %}

      <td data-th="{{ "accounts.carts.index.date" | t }}"><a href="{{ cart.select_path }}" data-method="put" rel="nofollow">{% render "shared/date", timestamp: cart.created_at %}</a>{{ is_current }}</td>
      <td data-th="{{ "accounts.carts.index.items" | t }}">{{ cart.item_count }}</td>
    </tr>
  </table>
{%- else %}
  <div class="sc-shade-neutral">{{ "accounts.profile.sections.carts.no_carts" | t }}</div>
{%- endif %}
